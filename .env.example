# Local development configuration.
#
# For local dev, credentials are read directly from these variables. In the
# deployed Lambda, they instead come from AWS Secrets Manager (see
# ZOHO_SECRET_ID below and scripts/oauth-setup.ts) - you do not need this
# file to deploy.
#
# Run `npm run oauth:setup` to generate these values interactively; it can
# also write this file for you.

# --- Zoho OAuth (Self Client) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Zoho data center for OAuth token refresh. If you're on sprints.zoho.com
# (not .eu/.in/.com.au/etc.), leave this as-is.
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com

# Zoho Sprints API base URL - only change this if you're on a non-.com data
# center (see https://sprints.zoho.com/apidoc.html#MultipleDC).
# ZOHO_API_BASE_URL=https://sprintsapi.zoho.com/zsapi

# Workspace (team) ID. Optional - auto-detected if your account belongs to
# exactly one Zoho Sprints workspace.
# ZOHO_TEAM_ID=

# Bearer token required on requests to /mcp. Leave unset locally if you're
# just testing against localhost; required in production (see README).
MCP_API_KEY=

# --- Server ---
# PORT=3000
# MCP_PATH=/mcp

# --- Lambda only (do not set locally) ---
# ZOHO_SECRET_ID=zoho-sprints-mcp/zoho-credentials
